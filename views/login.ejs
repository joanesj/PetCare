<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('./partials/head', { 
    title: 'Iniciar Sesión',
    description: 'Inicia sesión en PetCare para acceder a nuestros servicios exclusivos.',
    css: 'auth',
    isAuthPage: true 
  }); %>
    <meta name="google-signin-client_id" content="<%= GOOGLE_CLIENT_ID %>">
  <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <img src="/img/logo.jpeg" alt="PetCare Logo" class="auth-logo">
        <h1>Iniciar Sesión</h1>
      </div>

      <% if (messages.error) { %>
        <div class="alert alert-error"><%= messages.error %></div>
      <% } %>

      <form action="/auth/login" method="POST" class="auth-form">
        <div class="form-group">
          <label for="username">Email:</label>
          <input type="text" id="username" name="username" required>
        </div>

        <div class="form-group">
          <label for="password">Contraseña:</label>
          <input type="password" id="password" name="password" required>
        </div>

        <button type="submit" class="btn-primary">Iniciar Sesión</button>
      </form>

      <% if (GOOGLE_CLIENT_ID) { %>
        <div class="auth-divider">
          <span>o</span>
        </div>

       <div class="google-signin">
  <a href="/auth/google" class="btn-google">
    <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo">
    <span>Continuar con Google</span>
  </a>
</div>
      <% } %>

      <div class="auth-footer">
        <p>¿No tienes una cuenta? <a href="/auth/register">Regístrate</a></p>
      </div>
    </div>
  </div>
</body>
</html>